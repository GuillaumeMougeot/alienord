
[Unit]
Description=Google Cloud Storage application
After=updates.service
After=network.target
StartLimitIntervalSec=10
StartLimitBurst=3

[Service]
Type=simple
Restart=always
RestartSec=1
User=uploader
WorkingDirectory=/opt/apps/gcs
EnvironmentFile=-/opt/apps/gcs/.env
ExecStartPre=/bin/bash -c 'echo -e "USER_ID=$(id -u uploader)\nGROUP_ID=$(id -g uploader)\nDEVICE_ID=$(hostname)" > /opt/apps/gcs/.env'
ExecStart=/usr/bin/docker compose up --exit-code-from gcs

[Install]
WantedBy=multi-user.target