#!/bin/sh
# alienord 2026-11-19: one-boot trial of the rebuilt GPU driver (nvgpu.ko + NVIDIA's 35.2.1 clock fix).
# modprobe runs this instead of loading nvgpu (see /etc/modprobe.d/nvgpu-fix-trial.conf).
#  - No flag file: loads the ORIGINAL driver exactly as before.
#  - Flag file present: deletes it FIRST (so the fixed driver gets one boot only), makes a kernel
#    panic reset the unit after 10 s, then loads the fixed module. Any problem: loads the original.
# Undo: sudo rm /etc/modprobe.d/nvgpu-fix-trial.conf /usr/local/sbin/nvgpu-trial-load
PATH=/usr/sbin:/usr/bin:/sbin:/bin
DIR=/var/lib/nvgpu-fix
FLAG=$DIR/try-next-boot
FIXED=$DIR/nvgpu-fixed.ko
FIXED_SHA=761608e899ce995218b26393d223aa7d14ea5c32cb15efd8d1a669bb3242f3ec

say() { echo "nvgpu-trial: $*" > /dev/kmsg 2>/dev/null; }
original() { exec modprobe --ignore-install nvgpu $CMDLINE_OPTS; }

# one load at a time (udev and systemd-modules-load can both ask)
if command exec 9>/run/nvgpu-trial.lock 2>/dev/null; then flock 9; fi
grep -q '^nvgpu ' /proc/modules && exit 0

[ -e "$FLAG" ] || original

rm -f "$FLAG"; sync
if [ -e "$FLAG" ]; then
    say "could not delete the trial flag (root file system read-only?): loading the ORIGINAL driver"
    original
fi
if [ "$(sha256sum < "$FIXED" 2>/dev/null | cut -d' ' -f1)" != "$FIXED_SHA" ]; then
    say "fixed module missing or not the reviewed build: loading the ORIGINAL driver"
    original
fi
echo 10 > /proc/sys/kernel/panic
modprobe nvmap
say "TRIAL BOOT: loading the FIXED driver (flag consumed; a kernel panic resets the unit in 10 s)"
if insmod "$FIXED"; then
    echo "$(date '+%F %T') boot $(cat /proc/sys/kernel/random/boot_id): fixed driver loaded" >> $DIR/trial.log
    sync
    exit 0
fi
say "the fixed driver failed to load: loading the ORIGINAL driver"
original
