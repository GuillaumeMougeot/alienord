{
    "image": "bio-dgpu:dev",
    "remoteUser": "devel",
    "mounts": [
        "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix",
    ],
    "runArgs": [
        "--rm",
        "--network=host",
        "--gpus",
        "all",
        "--privileged",
        "-v",
        "/dev/bus/usb:/dev/bus/usb",
        "--cap-add=SYSLOG",
        "-e",
        "DISPLAY=${localEnv:DISPLAY}",
        "-e",
        "CUDA_CACHE_DISABLE=0",
        "-e",
        "LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib:/root/.local/lib:/opt/tritonserver/lib:/usr/src/tensorrt/lib:/opt/riva/lib:/usr/local/cuda/compat/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64",
        "-e",
        "ENV=dev",
        "-e",
        "GST_PLUGIN_PATH=/usr/local/lib/x86_64-linux-gnu/gstreamer-1.0",
        "-e",
        "__NV_PRIME_RENDER_OFFLOAD=1",
        "-e",
        "CUDA_MODULE_LOADING=LAZY"
    ],
    "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "eamodio.gitlens",
        "emeraldwalk.runonsave"
    ]
}